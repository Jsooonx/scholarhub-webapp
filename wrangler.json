{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scholarhub",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_VERSION": "20",
    "NEXT_PUBLIC_SITE_URL": "https://scholarhub.jsooonx.my.id",
    "RESEND_AUDIENCE_ID": "2228abdb-1e75-46d6-97cd-3a276d155327"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scholarhub-db",
      "database_id": "cc30337a-7773-463a-9a6e-5b38cccb558e"
    }
  ]
}
